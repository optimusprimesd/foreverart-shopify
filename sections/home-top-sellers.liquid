{%- liquid
  assign has_products = false
  for block in section.blocks
    if block.settings.product != blank
      assign has_products = true
      break
    endif
  endfor

  assign show_section = false
  if has_products or section.settings.heading != blank or section.settings.description != blank or request.design_mode
    assign show_section = true
  endif

  assign bg_brightness = section.settings.background_color | color_brightness
  assign use_solid_heading = section.settings.use_text_color_for_heading
  if use_solid_heading == false and bg_brightness > 160
    assign use_solid_heading = true
  endif
-%}
{%- if show_section -%}
  <section
    class="home-top-sellers relative z-10 px-4 py-16 md:px-6 md:py-20 lg:py-24"
    data-header-context="{{ section.settings.header_context }}"
    data-home-top-sellers
    data-home-top-sellers-intro
    aria-labelledby="home-top-sellers-heading-{{ section.id }}"
    style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }}; --home-top-sellers-text: {{ section.settings.text_color }}; --home-top-sellers-bg: {{ section.settings.background_color }}; --home-collections-text: {{ section.settings.text_color }}; --home-top-sellers-heading: {{ section.settings.text_color }}; --home-top-sellers-description: {{ section.settings.text_color | color_modify: 'alpha', 0.88 }};"
    {{ section.shopify_attributes }}
  >
    <div class="home-top-sellers__inner mx-auto w-full max-w-[1280px]">
      <div class="home-top-sellers__layout">
        {%- if has_products -%}
          <div class="home-top-sellers__grid" data-home-top-sellers-intro-grid>
            {%- for block in section.blocks limit: 4 -%}
              {%- if block.settings.product != blank -%}
                {%- assign card_product = block.settings.product -%}
                {%- assign card_product_image = card_product.featured_image | image_url: width: 600 -%}
                {%- assign card_product_price = card_product.price | money -%}
                {%- assign card_product_alt = card_product.title -%}
                <div class="home-top-sellers__item" {{ block.shopify_attributes }}>
                  {% render 'product-item',
                    product_item_image: card_product_image,
                    product_item_title: card_product.title,
                    product_item_price_amount: card_product_price,
                    product_item_href: card_product.url,
                    product_item_alt: card_product_alt
                  %}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        <aside class="home-top-sellers__aside">
          {%- if section.settings.heading != blank or request.design_mode -%}
            <h2
              id="home-top-sellers-heading-{{ section.id }}"
              class="home-collections__title home-top-sellers__title text-4xl md:text-5xl lg:text-6xl{% if use_solid_heading %} home-collections__title--solid{% endif %}"
              data-home-top-sellers-intro-heading
            >
              {{ section.settings.heading | default: 'Top Sellers' | escape }}
            </h2>
          {%- endif -%}

          <div class="home-top-sellers__meta">
            {%- if section.settings.description != blank or request.design_mode -%}
              <p class="home-top-sellers__description home-collections__description" data-home-top-sellers-intro-description>
                {{ section.settings.description | default: 'Discover our most-loved pieces, handcrafted for moments that matter.' | escape }}
              </p>
            {%- endif -%}

            {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
              <a href="{{ section.settings.cta_url }}" class="home-top-sellers__more shrink-0" data-home-top-sellers-intro-more>
                {{ section.settings.cta_label | escape }}
                <span aria-hidden="true">→</span>
              </a>
            {%- endif -%}
          </div>
        </aside>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Home top sellers",
  "tag": "section",
  "class": "home-top-sellers-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "use_text_color_for_heading",
      "label": "Use text color for title",
      "info": "When off, the title keeps the gold gradient style. On light backgrounds, text color is applied automatically.",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Top Sellers"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover our most-loved pieces, handcrafted for moments that matter."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "More button label",
      "default": "More"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "More button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "header_context",
      "label": "Header style",
      "info": "Controls navigation appearance over this section.",
      "options": [
        {
          "value": "light",
          "label": "Light header (dark text nav)"
        },
        {
          "value": "dark",
          "label": "Dark header (light text nav)"
        }
      ],
      "default": "dark"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home top sellers",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
