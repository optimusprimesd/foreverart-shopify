{%- comment -%}
  Gift card collection listing — uses the current collection object.
  Companion to templates/collection.gift-card-collection.liquid
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading | default: collection.title | default: 'Gift Cards'
  assign intro = section.settings.intro
  if intro == blank and collection.description != blank
    assign intro = collection.description
  endif
  assign list_by_amount = true
  if section.settings.list_by_amount == false
    assign list_by_amount = false
  endif
  assign display_count = 0
-%}

<div class="gift-cards-page collection-page gift-card-collection" data-page-intro data-header-context="light">
  <section class="collection-hero gift-cards-page__hero" aria-label="{{ heading | escape }}">
    <div class="collection-hero__media" data-page-intro-media>
      {%- if section.settings.hero_image != blank -%}
        {{
          section.settings.hero_image
          | image_url: width: 2000
          | image_tag:
            loading: 'eager',
            class: 'collection-hero__image',
            sizes: '100vw',
            widths: '800, 1200, 1600, 2000',
            alt: section.settings.hero_image.alt | default: heading | escape
        }}
      {%- elsif collection.image -%}
        {{
          collection.image
          | image_url: width: 2000
          | image_tag:
            loading: 'eager',
            class: 'collection-hero__image',
            sizes: '100vw',
            widths: '800, 1200, 1600, 2000',
            alt: collection.image.alt | default: heading | escape
        }}
      {%- else -%}
        <div class="collection-hero__image collection-hero__image--placeholder gift-cards-page__hero-fallback"></div>
      {%- endif -%}
    </div>

    <div class="collection-hero__overlay" aria-hidden="true" data-page-intro-overlay></div>

    <div class="collection-hero__content">
      <p class="gift-cards-page__eyebrow" data-page-intro-subtitle>Forever Art</p>
      <h1 class="collection-hero__title" data-page-intro-title>{{ heading | escape }}</h1>
      {%- if intro != blank -%}
        <div class="collection-hero__description gift-cards-page__intro" data-page-intro-subtitle>
          {{ intro }}
        </div>
      {%- endif -%}
    </div>
  </section>

  <div class="collection-page__container gift-cards-page__container">
    {%- paginate collection.products by 48 -%}
      {%- if collection.products.size > 0 -%}
        {%- for product in collection.products -%}
          {%- if list_by_amount -%}
            {%- for variant in product.variants -%}
              {%- if variant.available -%}
                {%- assign display_count = display_count | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- assign display_count = display_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}

        <header class="collection-page__header" data-page-intro-panel>
          <p class="collection-page__count">
            {{ display_count }}
            gift card{% if display_count != 1 %}s{% endif %}
            {%- if list_by_amount %} available{% endif %}
          </p>
        </header>

        <ul class="collection-grid gift-cards-page__grid" role="list">
          {%- for product in collection.products -%}
            {% render 'gift-card-product-card', product: product, list_variants: list_by_amount %}
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="collection-pagination" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a class="collection-pagination__link" href="{{ paginate.previous.url }}">Previous</a>
            {%- endif -%}
            <span class="collection-pagination__status">
              Page {{ paginate.current_page }} of {{ paginate.pages }}
            </span>
            {%- if paginate.next -%}
              <a class="collection-pagination__link" href="{{ paginate.next.url }}">Next</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="collection-empty">
          <p>No gift cards in this collection yet.</p>
          <p class="gift-cards-page__empty-hint">
            Add Gift Card products to this collection in Shopify Admin.
            Issued gift cards under <strong>Products → Gift cards</strong> are customer balances and do not appear here.
          </p>
          <a class="collection-empty__link" href="{{ routes.root_url }}">Back to home</a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Gift card collection",
  "tag": "section",
  "class": "gift-card-collection-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Assign template “gift-card-collection” on a Gift Cards collection. Products render with the gift card card layout."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gift Cards",
      "info": "Leave blank to use the collection title."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Give the gift of a Forever Art story. Choose an amount and send it instantly.</p>",
      "info": "Leave blank to use the collection description."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "Optional. Falls back to the collection image."
    },
    {
      "type": "checkbox",
      "id": "list_by_amount",
      "label": "Show each amount as its own card",
      "default": true,
      "info": "If a gift card product has variants ($100, $200, $500), each amount appears as a separate card."
    }
  ]
}
{% endschema %}
