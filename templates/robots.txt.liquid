{% comment %}
  robots.txt — Shopify default crawl rules + sitemap.
  XML sitemap is auto-generated by Shopify at /sitemap.xml
  (products, collections, pages, blogs, and their images).
{% endcomment %}
{% for group in robots.default_groups %}
  {{- group.user_agent -}}

  {% for rule in group.rules %}
    {{- rule -}}
  {% endfor %}

  {%- if group.sitemap != blank -%}
    {{ group.sitemap }}
  {%- endif -%}
{% endfor %}
