{%- assign field = field | default: nil -%}
{%- assign product = product | default: nil -%}
{%- if field != nil and product != nil -%}

{%- assign field_key = field.key | default: 'background_color' -%}
{%- assign field_label = field.label | default: 'Background Colour' -%}
{%- assign show_help = field.show_help | default: false -%}
{%- assign show_voice_enabled = false -%}
{%- if field.show_voice == true or field.show_voice == 'true' -%}
  {%- assign show_voice_enabled = true -%}
{%- endif -%}
{%- assign help_title = field.help_title | default: field_label -%}
{%- assign help_body = field.help_body | default: '' -%}
{%- assign tooltip_id = 'background-color-help-tooltip' -%}
{%- assign field_charge_cents = 0 -%}
{%- if field.additional_charge != blank -%}
  {%- assign field_charge_cents = field.additional_charge | times: 100 | round -%}
{%- endif -%}

{%- assign background_option = nil -%}
{%- for option in product.options_with_values -%}
  {%- assign option_name_down = option.name | downcase -%}
  {%- if option.name == 'Background Colour' or option.name == 'Background Color' or option_name_down == 'background' or option_name_down contains 'background colour' or option_name_down contains 'background color' -%}
    {%- assign background_option = option -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

<div class="wizard__select-field w-full">
  <div class="wizard__select-field-box">
    <div class="wizard__select-field-header flex w-full flex-wrap items-center justify-between gap-2">
      <p class="product-page__label mb-0 min-w-0 flex-1 text-base font-bold text-[#141414]">
        {{ field_label }}
        <span class="product-page__color-name ml-1 inline-block rounded bg-black px-2 py-0.5 text-xs font-medium text-white" data-background-color-label style="display:none;"></span>
      </p>
      {% render 'product-field-header-actions',
        product: product,
        field_key: field_key,
        tooltip_id: tooltip_id,
        tooltip_aria_label: 'Information about background colours',
        show_help: show_help,
        tooltip_title: help_title,
        tooltip_body: help_body,
        show_voice: show_voice_enabled,
        show_video: field.show_video,
        media_url: field.media_url,
        voice_src: field.voice_src
      %}
    </div>
    <div class="product-page__color-dropdown" data-background-color-dropdown>
      <input type="hidden" name="properties[Background color]" value="" data-background-color-input aria-required="true"{% if field_charge_cents > 0 %} data-additional-charge-cents="{{ field_charge_cents }}"{% endif %} />
      <button
        type="button"
        id="background-color-trigger"
        class="product-page__color-dropdown-trigger product-page__input"
        data-background-color-trigger
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-controls="background-color-listbox"
        aria-label="Background colour"
        aria-required="true"
      >
        <span class="product-page__color-dropdown-swatch" data-background-color-swatch aria-hidden="true"></span>
        <span class="product-page__color-dropdown-value" data-background-color-value>Select a colour</span>
        <i class="product-page__color-dropdown-chevron hgi hgi-stroke hgi-rounded hgi-arrow-down-01" aria-hidden="true"></i>
      </button>
      <ul
        id="background-color-listbox"
        class="product-page__color-dropdown-menu"
        role="listbox"
        aria-labelledby="background-color-trigger"
        hidden
        data-background-color-menu
      >
        {%- if background_option != nil -%}
          {%- for value in background_option.values -%}
            {%- assign color = value.name | default: value | strip -%}
            {%- unless color == '' -%}
              {%- capture color_hex -%}
                {%- render 'product-color-hex', color_name: color, product: product, output: 'hex', option_name: background_option.name -%}
              {%- endcapture -%}
              {%- capture color_display_name -%}
                {%- render 'product-color-hex', color_name: color, product: product, output: 'label', option_name: background_option.name -%}
              {%- endcapture -%}
              {%- capture color_code -%}
                {%- render 'product-color-hex', color_name: color, product: product, output: 'code', option_name: background_option.name -%}
              {%- endcapture -%}
              {%- capture color_display -%}
                {%- render 'product-color-hex', color_name: color, product: product, output: 'display', option_name: background_option.name -%}
              {%- endcapture -%}
              {%- assign color_hex = color_hex | strip -%}
              {%- assign color_display_name = color_display_name | strip -%}
              {%- assign color_code = color_code | strip -%}
              {%- assign color_display = color_display | strip -%}
              {%- if color_hex == blank and value.swatch.color -%}
                {%- assign color_hex = value.swatch.color -%}
              {%- endif -%}
              <li role="presentation">
                <button
                  type="button"
                  class="product-page__color-dropdown-option"
                  role="option"
                  data-background-color-option
                  data-value="{{ color_display_name | downcase | handle }}"
                  data-color-name="{{ color_display_name }}"
                  data-color-code="{{ color_code }}"
                  data-color-display="{{ color_display }}"
                  data-hex="{{ color_hex }}"
                  aria-selected="false"
                >
                  <span class="product-page__color-dropdown-option-dot"{% if color_hex != blank %} style="background-color: {{ color_hex }}"{% endif %} aria-hidden="true"></span>
                  {{ color_display }}
                </button>
              </li>
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </div>
  {% render 'product-form-field-info', info_label: field.info_label, additional_charge: field.additional_charge %}
</div>
{%- endif -%}
