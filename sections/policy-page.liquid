{%- liquid
  assign hero_eyebrow = section.settings.hero_eyebrow
  assign hero_heading = section.settings.hero_heading | default: page.title
  assign hero_lede = section.settings.hero_lede
  assign closing_heading = section.settings.closing_heading
  assign closing_body = section.settings.closing_body
  assign show_page_content = section.settings.show_page_content
  if show_page_content == nil
    assign show_page_content = true
  endif
-%}

<div class="about-us policy-page" data-header-context="dark">
  <header class="about-us__hero">
    <div class="about-us__hero-inner">
      {%- if hero_eyebrow != blank -%}
        <p class="about-us__eyebrow">{{ hero_eyebrow | escape }}</p>
      {%- endif -%}
      {%- if hero_heading != blank -%}
        <h1 class="about-us__hero-heading">{{ hero_heading | escape }}</h1>
      {%- endif -%}
      {%- if hero_lede != blank -%}
        <p class="about-us__hero-lede">{{ hero_lede | escape }}</p>
      {%- endif -%}
    </div>
  </header>

  <div class="about-us__body">
    {%- if show_page_content and page.content != blank -%}
      <section class="about-us__chapter">
        <div class="about-us__chapter-inner">
          <div class="about-us__prose policy-page__content">
            {{ page.content }}
          </div>
        </div>
      </section>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'chapter' -%}
          <section
            class="about-us__chapter{% if block.settings.tone == 'dark' %} about-us__chapter--dark{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="about-us__chapter-inner">
              {%- if block.settings.kicker != blank -%}
                <p class="about-us__kicker">{{ block.settings.kicker | escape }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="about-us__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <div class="about-us__prose">
                  {{ block.settings.body }}
                </div>
              {%- endif -%}
            </div>
          </section>

        {%- when 'pullquote' -%}
          <figure class="about-us__pullquote" {{ block.shopify_attributes }}>
            <blockquote class="about-us__quote">
              <p>{{ block.settings.quote | escape }}</p>
            </blockquote>
            {%- if block.settings.attribution != blank -%}
              <figcaption class="about-us__quote-attr">{{ block.settings.attribution | escape }}</figcaption>
            {%- endif -%}
          </figure>

        {%- when 'callout' -%}
          <section class="about-us__plate" {{ block.shopify_attributes }}>
            <div class="about-us__plate-inner">
              <div class="about-us__plate-copy">
                {%- if block.settings.kicker != blank -%}
                  <p class="about-us__kicker">{{ block.settings.kicker | escape }}</p>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="about-us__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <div class="about-us__prose">
                    {{ block.settings.body }}
                  </div>
                {%- endif -%}
              </div>
              <div class="about-us__plate-card" aria-hidden="true">
                <p class="about-us__plate-label">{{ block.settings.card_label | default: 'Note' | escape }}</p>
                <p class="about-us__plate-number">{{ block.settings.card_title | default: 'Policy' | escape }}</p>
                <p class="about-us__plate-note">{{ block.settings.card_note | escape }}</p>
              </div>
            </div>
          </section>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- if closing_heading != blank or closing_body != blank or section.settings.cta_label != blank -%}
    <section class="about-us__closing">
      <div class="about-us__closing-inner">
        {%- if closing_heading != blank -%}
          <h2 class="about-us__closing-heading">{{ closing_heading | escape }}</h2>
        {%- endif -%}
        {%- if closing_body != blank -%}
          <div class="about-us__prose about-us__prose--on-dark">
            {{ closing_body }}
          </div>
        {%- endif -%}
        {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
          <a class="about-us__cta" href="{{ section.settings.cta_url }}">
            {{ section.settings.cta_label | escape }}
            <span aria-hidden="true">→</span>
          </a>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Policy page",
  "tag": "section",
  "class": "policy-page-section",
  "settings": [
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Hero eyebrow",
      "default": "Policy"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "info": "Leave blank to use the page title."
    },
    {
      "type": "textarea",
      "id": "hero_lede",
      "label": "Hero lede"
    },
    {
      "type": "checkbox",
      "id": "show_page_content",
      "label": "Show Shopify page content",
      "default": true,
      "info": "Renders the page body from the admin above any chapter blocks."
    },
    {
      "type": "text",
      "id": "closing_heading",
      "label": "Closing heading",
      "default": "Need help?"
    },
    {
      "type": "richtext",
      "id": "closing_body",
      "label": "Closing body",
      "default": "<p>If you have a question about this policy, we’re happy to help.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Chapter",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Kicker" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Overview" },
        { "type": "richtext", "id": "body", "label": "Body" },
        {
          "type": "select",
          "id": "tone",
          "label": "Tone",
          "options": [
            { "value": "light", "label": "Light" },
            { "value": "dark", "label": "Dark" }
          ],
          "default": "light"
        }
      ]
    },
    {
      "type": "pullquote",
      "name": "Pull quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Please take a moment to check all personalised information carefully."
        },
        { "type": "text", "id": "attribution", "label": "Attribution" }
      ]
    },
    {
      "type": "callout",
      "name": "Callout",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Important" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Made to order" },
        { "type": "richtext", "id": "body", "label": "Body" },
        { "type": "text", "id": "card_label", "label": "Card label", "default": "Note" },
        { "type": "text", "id": "card_title", "label": "Card title", "default": "Policy" },
        { "type": "text", "id": "card_note", "label": "Card note" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Policy page"
    }
  ]
}
{% endschema %}
