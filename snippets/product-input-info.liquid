{%- assign input_info_name = input_info_name | default: '' -%}
{%- assign input_info_type = input_info_type | default: 'text' -%}
{%- assign input_info_placeholder = input_info_placeholder | default: '' -%}
{%- assign input_info_id = input_info_id | default: '' -%}
{%- assign input_info_class = input_info_class | default: '' -%}
{%- assign input_info_autocomplete = input_info_autocomplete | default: '' -%}
{%- assign input_info_required = input_info_required | default: false -%}
{%- assign input_info_aria_label = input_info_aria_label | default: 'More information' -%}
{%- assign input_info_rows = input_info_rows | default: '' -%}
{%- assign input_info_wrap_class = input_info_wrap_class | default: '' -%}
{%- assign input_info_inputmode = input_info_inputmode | default: '' -%}
{%- assign input_info_options = input_info_options | default: '' -%}
{%- assign input_info_max_length = input_info_max_length | default: '' -%}
{%- assign input_info_alphanumeric_only = input_info_alphanumeric_only | default: false -%}
{%- assign input_info_label = input_info_label | default: '' -%}
{%- assign input_info_additional_charge = input_info_additional_charge | default: '' -%}
{%- assign input_info_show_input_on_selection = input_info_show_input_on_selection | default: false -%}
{%- assign input_info_selection_input_key = input_info_selection_input_key | default: '' -%}
{%- assign input_info_selection_input_property_name = input_info_selection_input_property_name | default: '' -%}
{%- assign input_info_selection_input_placeholder = input_info_selection_input_placeholder | default: '' -%}
{%- assign input_info_selection_input_required = input_info_selection_input_required | default: false -%}
{%- assign input_info_selection_input_type = input_info_selection_input_type | default: 'text' -%}
{%- assign input_info_option_modes = input_info_option_modes | default: '' -%}
{%- assign input_info_hide_selection_values = input_info_hide_selection_values | default: '' -%}
{%- assign input_info_show_selection_values = input_info_show_selection_values | default: '' -%}
{%- assign input_info_options_source = input_info_options_source | default: '' -%}
{%- assign input_info_date_properties = input_info_date_properties | default: nil -%}
{%- assign input_info_show_char_count = input_info_show_char_count | default: false -%}
{%- assign input_charge_cents = 0 -%}
{%- if input_info_additional_charge != blank -%}
  {%- assign input_charge_cents = input_info_additional_charge | times: 100 | round -%}
{%- endif -%}
{%- assign field_description_key = input_info_name -%}
{%- if description_key != blank -%}
  {%- assign field_description_key = description_key -%}
{%- endif -%}
{%- assign field_tooltip_id = '' -%}
{%- if input_info_id != blank -%}
  {%- assign field_tooltip_id = 'help-tooltip-' | append: input_info_id -%}
{%- elsif input_info_name != blank -%}
  {%- assign field_tooltip_id = 'help-tooltip-' | append: input_info_name -%}
{%- endif -%}

{%- assign field_desc = nil -%}
{%- if product and field_description_key != blank -%}
  {%- assign field_desc = product.metafields.custom[field_description_key] -%}
{%- endif -%}

{%- assign show_field_help = false -%}
{%- assign show_field_voice = false -%}
{%- assign show_field_video = false -%}

{%- if input_info_show_help == true or input_info_show_help == 'true' -%}
  {%- assign show_field_help = true -%}
{%- elsif input_info_show_help == false or input_info_show_help == 'false' -%}
  {%- assign show_field_help = false -%}
{%- elsif field_desc -%}
  {%- if field_desc.title != blank or field_desc.description != blank -%}
    {%- assign show_field_help = true -%}
  {%- endif -%}
{%- elsif input_info_tooltip_title != blank or input_info_tooltip_body != blank -%}
  {%- assign show_field_help = true -%}
{%- endif -%}

{%- if input_info_show_voice == true or input_info_show_voice == 'true' -%}
  {%- assign show_field_voice = true -%}
{%- elsif input_info_show_voice == false or input_info_show_voice == 'false' -%}
  {%- assign show_field_voice = false -%}
{%- elsif field_desc and field_desc.voice -%}
  {%- assign show_field_voice = true -%}
{%- endif -%}

{%- if input_info_show_video == true or input_info_show_video == 'true' -%}
  {%- assign show_field_video = true -%}
{%- elsif input_info_show_video == false or input_info_show_video == 'false' -%}
  {%- assign show_field_video = false -%}
{%- elsif input_info_media_url != blank -%}
  {%- assign show_field_video = true -%}
{%- endif -%}

{%- assign field_tooltip_title = field_desc.title | default: input_info_tooltip_title | default: input_info_placeholder -%}
{%- assign field_tooltip_body = field_desc.description | default: input_info_tooltip_body | default: '' -%}
{%- assign field_voice_audio_id = 'voice-audio-' | append: field_description_key -%}
{%- assign field_voice_src = field_desc.voice_src | default: input_info_voice_src | default: 'wedding-poster.m4a' | asset_url -%}
{%- assign field_video_slide_index = input_info_media_url | default: '' -%}
{%- assign has_actions = false -%}
{%- if show_field_help or show_field_voice or show_field_video -%}
  {%- assign has_actions = true -%}
{%- endif -%}

{%- assign show_selection_input = false -%}
{%- if input_info_type == 'select' and input_info_show_input_on_selection -%}
  {%- assign show_selection_input = true -%}
{%- endif -%}
{%- comment -%}Countries source: always offer an Other country text input{%- endcomment -%}
{%- if input_info_type == 'select' and input_info_options_source == 'countries' -%}
  {%- assign show_selection_input = true -%}
  {%- if input_info_show_selection_values == blank -%}
    {%- assign input_info_show_selection_values = 'Other' -%}
  {%- endif -%}
  {%- if input_info_selection_input_placeholder == blank -%}
    {%- assign input_info_selection_input_placeholder = 'Enter country' -%}
  {%- endif -%}
  {%- if input_info_selection_input_property_name == blank and input_info_name != blank -%}
    {%- assign input_info_selection_input_property_name = input_info_name | append: ' (Other)' -%}
  {%- endif -%}
  {%- if input_info_selection_input_key == blank and input_info_id != blank -%}
    {%- assign input_info_selection_input_key = input_info_id | append: '_other' -%}
  {%- endif -%}
{%- endif -%}
{%- assign selection_input_property = input_info_selection_input_property_name | default: input_info_selection_input_key -%}
{%- if show_selection_input and selection_input_property == blank and input_info_name != blank -%}
  {%- assign selection_input_property = input_info_name | append: '_detail' -%}
{%- endif -%}
{%- assign selection_input_id = input_info_selection_input_key | default: selection_input_property -%}
{%- assign select_field_key = input_info_id | default: input_info_name -%}

{%- if input_info_type == 'select' -%}
  {%- if show_selection_input -%}<div class="wizard__select-with-input">{%- endif -%}
  <div class="wizard__select-field w-full {{ input_info_wrap_class }}">
    <div class="wizard__select-field-box">
      <div class="wizard__select-field-header flex w-full flex-wrap items-center justify-between gap-2">
        {%- if input_info_id != blank -%}
          <label for="{{ input_info_id }}" class="product-page__label mb-0 min-w-0 flex-1 text-base font-bold text-[#141414]">{{ input_info_placeholder }}</label>
        {%- else -%}
          <p class="product-page__label mb-0 min-w-0 flex-1 text-base font-bold text-[#141414]">{{ input_info_placeholder }}</p>
        {%- endif -%}
        {%- if has_actions -%}
          {% render 'product-field-header-actions',
            product: product,
            field_key: select_field_key,
            tooltip_id: field_tooltip_id,
            tooltip_aria_label: input_info_aria_label,
            show_help: show_field_help,
            tooltip_title: field_tooltip_title,
            tooltip_body: field_tooltip_body,
            show_voice: show_field_voice,
            show_video: show_field_video,
            media_url: input_info_media_url,
            voice_src: input_info_voice_src
          %}
        {%- endif -%}
      </div>
      <div class="wizard__input-info-wrap wizard__input-info-wrap--select-only">
        <select
          name="properties[{{ input_info_name }}]"
          {% if input_info_id != blank %}id="{{ input_info_id }}"{% endif %}
          class="product-page__input product-page__input--select w-full {{ input_info_class }}"
          aria-label="{{ input_info_placeholder }}"
          {% if input_info_required %}aria-required="true"{% endif %}
          {% if input_charge_cents > 0 %}data-additional-charge-cents="{{ input_charge_cents }}"{% endif %}
          {% if show_selection_input %}data-show-input-on-selection{% endif %}
          {% if input_info_hide_selection_values != blank %}data-hide-selection-values="{{ input_info_hide_selection_values | escape }}"{% endif %}
          {% if input_info_show_selection_values != blank %}data-show-selection-values="{{ input_info_show_selection_values | escape }}"{% endif %}
        >
          <option value="" disabled selected>Select an option</option>
          {%- if input_info_options_source == 'countries' -%}
            {% render 'product-country-options' %}
          {%- else -%}
          {% assign input_info_option_list = input_info_options | split: ',' %}
          {%- assign option_modes_list = input_info_option_modes | split: ',' -%}
          {% for option in input_info_option_list %}
            {% assign option_label = option | strip %}
            {% if option_label != blank %}
              {%- assign option_selection_mode = '' -%}
              {%- if option_modes_list.size > 0 and option_modes_list[forloop.index0] != blank -%}
                {%- assign option_selection_mode = option_modes_list[forloop.index0] | strip -%}
              {%- elsif input_info_selection_input_type == 'property_date' -%}
                {%- assign option_label_lc = option_label | downcase -%}
                {%- if option_label_lc contains 'entry' and option_label_lc contains 'exit' -%}
                  {%- assign option_selection_mode = 'year_range' -%}
                {%- elsif option_label_lc contains 'circa' -%}
                  {%- assign option_selection_mode = 'circa_year' -%}
                {%- elsif option_label_lc contains 'no record' -%}
                  {%- assign option_selection_mode = 'no_record' -%}
                {%- elsif option_label_lc contains 'date specific' or option_label_lc contains 'exact date' or option_label_lc contains 'birth date' or option_label_lc == 'current' or option_label_lc == 'date' or option_label_lc contains 'birthdate' -%}
                  {%- assign option_selection_mode = 'date' -%}
                {%- elsif option_label_lc contains 'single' and option_label_lc contains 'year' -%}
                  {%- assign option_selection_mode = 'year' -%}
                {%- elsif option_label_lc contains 'birth year' or option_label_lc contains 'year' -%}
                  {%- assign option_selection_mode = 'year' -%}
                {%- elsif option_label_lc contains 'date' -%}
                  {%- assign option_selection_mode = 'date' -%}
                {%- endif -%}
              {%- endif -%}
              <option value="{{ option_label }}"{% if option_selection_mode != blank %} data-selection-mode="{{ option_selection_mode }}"{% endif %}>{{ option_label }}</option>
            {% endif %}
          {% endfor %}
          {%- endif -%}
        </select>
      </div>

      {%- if show_selection_input and input_info_selection_input_type == 'property_date' -%}
        {%- assign date_property_date = 'Property Date' -%}
        {%- assign date_property_year = 'Property Year' -%}
        {%- assign date_property_circa_year = 'Property Year' -%}
        {%- if input_info_date_properties -%}
          {%- if input_info_date_properties.date != blank -%}
            {%- assign date_property_date = input_info_date_properties.date -%}
          {%- endif -%}
          {%- if input_info_date_properties.year != blank -%}
            {%- assign date_property_year = input_info_date_properties.year -%}
          {%- endif -%}
          {%- if input_info_date_properties.circa_year != blank -%}
            {%- assign date_property_circa_year = input_info_date_properties.circa_year -%}
          {%- else -%}
            {%- assign date_property_circa_year = date_property_year -%}
          {%- endif -%}
        {%- endif -%}
        <div
          class="wizard__select-dependent-input wizard__select-dependent-input--property-date"
          data-select-dependent-input
          data-select-dependent-type="property_date"
          {% if input_info_selection_input_required %}data-selection-input-required="true"{% endif %}
          hidden
        >
          {% render 'product-select-property-date-inputs',
            date_field_key: select_field_key,
            date_input_required: input_info_selection_input_required,
            single_year_property: date_property_year,
            circa_year_property: date_property_circa_year,
            specific_date_property: date_property_date
          %}
        </div>
      {%- elsif show_selection_input -%}
        <div
          class="wizard__select-dependent-input"
          data-select-dependent-input
          {% if input_info_selection_input_required %}data-selection-input-required="true"{% endif %}
          hidden
        >
          <input
            type="text"
            name="properties[{{ selection_input_property }}]"
            {% if selection_input_id != blank %}id="{{ selection_input_id }}"{% endif %}
            placeholder="{{ input_info_selection_input_placeholder | escape }}"
            class="product-page__input w-full"
            {% if input_info_selection_input_placeholder != blank %}data-selection-input-placeholder="{{ input_info_selection_input_placeholder | escape }}"{% endif %}
            {% if input_info_selection_input_required %}data-selection-input-required="true"{% endif %}
            disabled
            aria-hidden="true"
          >
        </div>
      {%- endif -%}
    </div>
  </div>
  {%- if show_selection_input -%}</div>{%- endif -%}

  {% render 'product-form-field-info', info_label: input_info_label, additional_charge: input_info_additional_charge %}
{%- else -%}
<div class="wizard__input-info-wrap{% if input_info_rows != blank %} wizard__input-info-wrap--textarea{% endif %}{% if has_actions %} wizard__input-info-wrap--has-actions{% endif %}{% if show_field_help and show_field_voice %} wizard__input-info-wrap--has-help-voice{% elsif has_actions %} wizard__input-info-wrap--has-help{% endif %} {{ input_info_wrap_class }}">
  {% if input_info_rows != blank %}
    <textarea
      name="properties[{{ input_info_name }}]"
      {% if input_info_id != blank %}id="{{ input_info_id }}"{% endif %}
      rows="{{ input_info_rows }}"
      placeholder="{{ input_info_placeholder }}"
      class="product-page__input product-page__input--textarea w-full {{ input_info_class }}"
      {% if input_info_required %}aria-required="true"{% endif %}
      {% if input_info_max_length != blank %}maxlength="{{ input_info_max_length }}" data-char-count{% endif %}
      {% if input_info_alphanumeric_only %}inputmode="text" autocapitalize="characters"{% endif %}
      {% if input_charge_cents > 0 %}data-additional-charge-cents="{{ input_charge_cents }}"{% endif %}
    ></textarea>
    {% if input_info_max_length != blank %}
      <p class="wizard__char-count mt-1 text-right text-sm text-[#6b6b6b]" data-char-count-for="{% if input_info_id != blank %}{{ input_info_id }}{% else %}{{ input_info_name | handle }}{% endif %}" aria-live="polite">
        <span data-char-count-current>0</span>/{{ input_info_max_length }}
      </p>
    {% endif %}
  {% else %}
    <input
      type="{{ input_info_type }}"
      name="properties[{{ input_info_name }}]"
      {% if input_info_id != blank %}id="{{ input_info_id }}"{% endif %}
      placeholder="{{ input_info_placeholder }}"
      class="product-page__input w-full {{ input_info_class }}"
      {% if input_info_autocomplete != blank %}autocomplete="{{ input_info_autocomplete }}"{% endif %}
      {% if input_info_inputmode != blank %}inputmode="{{ input_info_inputmode }}"{% endif %}
      {% if input_info_max_length != blank %}maxlength="{{ input_info_max_length }}"{% endif %}
      {% if input_info_alphanumeric_only and input_info_inputmode == blank %}inputmode="text" autocapitalize="characters"{% endif %}
      {% if input_info_required %}aria-required="true"{% endif %}
      {% if input_charge_cents > 0 %}data-additional-charge-cents="{{ input_charge_cents }}"{% endif %}
    />
  {% endif %}

  {% if has_actions %}
    {% render 'product-field-trailing-actions',
      show_help: show_field_help,
      show_voice: show_field_voice,
      show_video: show_field_video,
      tooltip_id: field_tooltip_id,
      tooltip_aria_label: input_info_aria_label,
      tooltip_title: field_tooltip_title,
      tooltip_body: field_tooltip_body,
      voice_audio_id: field_voice_audio_id,
      voice_aria_label: field_tooltip_title,
      video_url: field_video_slide_index,
      video_aria_label: field_tooltip_title
    %}
  {% endif %}
</div>

{% render 'product-form-field-info', info_label: input_info_label, additional_charge: input_info_additional_charge %}

{% if show_field_voice %}
  {% render 'product-field-description-audio',
    field_audio_id: field_voice_audio_id,
    field_audio_src: field_voice_src,
    field_audio_label: field_tooltip_title
  %}
{% endif %}
{%- endif -%}
