{%- liquid
  assign slide_count = 0
  for block in section.blocks
    if block.settings.product != blank or block.settings.image != blank or block.settings.description != blank
      assign slide_count = slide_count | plus: 1
    endif
  endfor

  assign show_section = false
  if slide_count > 0 or request.design_mode
    assign show_section = true
  endif

  assign autoplay_delay = section.settings.autoplay_delay | default: 5
  if autoplay_delay < 2
    assign autoplay_delay = 2
  endif
-%}
{%- if show_section -%}
  <section
    class="home-featured-collection relative z-10"
    data-header-context="{{ section.settings.header_context }}"
    data-home-featured-collection
    data-autoplay-delay="{{ autoplay_delay | times: 1000 }}"
    aria-labelledby="home-featured-collection-heading-{{ section.id }}"
    style="
      --hfc-panel-bg: {{ section.settings.panel_background }};
      --hfc-panel-text: {{ section.settings.panel_text_color }};
      --hfc-cta-bg: {{ section.settings.cta_background }};
      --hfc-cta-text: {{ section.settings.cta_text_color }};
    "
    {{ section.shopify_attributes }}
  >
    <div class="home-featured-collection__layout" data-home-featured-carousel>
      <div
        class="swiper home-featured-collection__media"
        data-home-featured-media-swiper
        aria-live="polite"
      >
        <div class="swiper-wrapper">
          {%- assign slide_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign slide_product = block.settings.product
              assign slide_collection = block.settings.collection
              assign slide_image = block.settings.image
              if slide_image == blank and slide_product != blank and slide_product.featured_image != blank
                assign slide_image = slide_product.featured_image
              endif
              if slide_image == blank and slide_collection != blank and slide_collection.image != blank
                assign slide_image = slide_collection.image
              endif

              assign slide_alt = block.settings.image_alt
              if slide_alt == blank and slide_product != blank
                assign slide_alt = slide_product.title
              endif
              if slide_alt == blank and slide_collection != blank
                assign slide_alt = slide_collection.title
              endif
              if slide_alt == blank
                assign slide_alt = section.settings.heading
              endif
              assign slide_alt = slide_alt | escape

              assign has_slide = false
              if slide_product != blank or block.settings.image != blank or block.settings.description != blank
                assign has_slide = true
              endif
              if has_slide == false and slide_product != blank and slide_product.description != blank
                assign has_slide = true
              endif
            -%}
            {%- if has_slide or request.design_mode -%}
              {%- assign is_first_slide = false -%}
              {%- if slide_index == 0 -%}
                {%- assign is_first_slide = true -%}
              {%- endif -%}
              <div class="swiper-slide" {{ block.shopify_attributes }}>
                <figure class="home-featured-collection__media-slide">
                  {%- if slide_image != blank -%}
                    {%- if is_first_slide -%}
                      {{
                        slide_image
                        | image_url: width: 2000
                        | image_tag:
                          class: 'home-featured-collection__image',
                          alt: slide_alt,
                          loading: 'eager',
                          widths: '800, 1200, 1600, 2000',
                          sizes: '(min-width: 1024px) 70vw, 100vw'
                      }}
                    {%- else -%}
                      {{
                        slide_image
                        | image_url: width: 2000
                        | image_tag:
                          class: 'home-featured-collection__image',
                          alt: slide_alt,
                          loading: 'lazy',
                          widths: '800, 1200, 1600, 2000',
                          sizes: '(min-width: 1024px) 70vw, 100vw'
                      }}
                    {%- endif -%}
                  {%- else -%}
                    <div class="home-featured-collection__image-placeholder" aria-hidden="true"></div>
                  {%- endif -%}
                </figure>
              </div>
              {%- assign slide_index = slide_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <aside class="home-featured-collection__panel">
        <div class="home-featured-collection__panel-inner">
          {%- if section.settings.heading != blank -%}
            <h2
              id="home-featured-collection-heading-{{ section.id }}"
              class="home-featured-collection__heading"
            >
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}

          <div
            class="swiper home-featured-collection__content"
            data-home-featured-content-swiper
            aria-live="polite"
          >
            <div class="swiper-wrapper">
              {%- assign slide_index = 0 -%}
              {%- for block in section.blocks -%}
                {%- liquid
                  assign slide_product = block.settings.product
                  assign slide_collection = block.settings.collection
                  assign has_slide = false
                  if slide_product != blank or block.settings.image != blank or block.settings.description != blank
                    assign has_slide = true
                  endif
                  if has_slide == false and slide_product != blank and slide_product.description != blank
                    assign has_slide = true
                  endif
                -%}
                {%- if has_slide or request.design_mode -%}
                  {%- liquid
                    assign slide_title = ''
                    if slide_product != blank
                      assign slide_title = slide_product.title
                    elsif slide_collection != blank
                      assign slide_title = slide_collection.title
                    endif

                    assign slide_description = block.settings.description
                    if slide_description == blank and slide_product != blank and slide_product.description != blank
                      assign slide_description = slide_product.description | strip_html | strip
                    endif

                    assign cta_label = block.settings.cta_label
                    if cta_label == blank and slide_collection != blank
                      assign cta_label = 'View ' | append: slide_collection.title
                    endif
                    if cta_label == blank
                      assign cta_label = section.settings.cta_label_fallback
                    endif

                    assign cta_url = block.settings.cta_url
                    if cta_url == blank and slide_collection != blank
                      assign cta_url = slide_collection.url
                    endif
                    if cta_url == blank and slide_product != blank
                      assign cta_url = slide_product.url
                    endif
                  -%}
                  <div class="swiper-slide">
                    <div class="home-featured-collection__slide">
                      {%- if slide_title != blank -%}
                        <h3 class="home-featured-collection__product-title">
                          {%- if slide_product != blank -%}
                            <a href="{{ slide_product.url }}" class="home-featured-collection__product-link">
                              {{ slide_title | escape }}
                            </a>
                          {%- else -%}
                            {{ slide_title | escape }}
                          {%- endif -%}
                        </h3>
                      {%- endif -%}

                      {%- if slide_description != blank -%}
                        <p class="home-featured-collection__description">
                          {{ slide_description | escape | newline_to_br }}
                        </p>
                      {%- endif -%}

                      {%- if block.settings.tagline != blank -%}
                        <p class="home-featured-collection__tagline">
                          “{{ block.settings.tagline | escape }}”
                        </p>
                      {%- endif -%}

                      {%- if cta_label != blank and cta_url != blank -%}
                        <a href="{{ cta_url }}" class="home-featured-collection__cta">
                          {{ cta_label | escape }}
                        </a>
                      {%- endif -%}
                    </div>
                  </div>
                  {%- assign slide_index = slide_index | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          <div class="home-featured-collection__nav" data-home-featured-nav>
            <div
              class="home-featured-collection__pagination swiper-pagination"
              data-home-featured-pagination
            ></div>
            <div class="home-featured-collection__nav-arrows">
              <button
                type="button"
                class="home-featured-collection__nav-btn"
                data-home-featured-prev
                aria-label="Previous featured product"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M15 6L9 12L15 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <button
                type="button"
                class="home-featured-collection__nav-btn"
                data-home-featured-next
                aria-label="Next featured product"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "class": "home-featured-collection-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "select",
      "id": "header_context",
      "label": "Header style",
      "info": "Controls navigation appearance over this section.",
      "options": [
        {
          "value": "light",
          "label": "Light header (dark text nav)"
        },
        {
          "value": "dark",
          "label": "Dark header (light text nav)"
        }
      ],
      "default": "dark"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay delay",
      "min": 2,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5,
      "info": "Seconds between slides. Autoplay pauses on hover."
    },
    {
      "type": "text",
      "id": "cta_label_fallback",
      "label": "Default button label",
      "default": "View Collection",
      "info": "Used when a slide has no button label and no collection title."
    },
    {
      "type": "header",
      "content": "Panel colors"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Panel background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "panel_text_color",
      "label": "Panel text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cta_background",
      "label": "Button background",
      "default": "#A89078"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "featured_slide",
      "name": "Collection product",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Used for the button link and default button label."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Pick any product from the collection. Title and description are taken from the product."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Lifestyle image",
          "info": "Falls back to the product image, then the collection image."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "info": "Optional override. When empty, the selected product’s description is used."
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline",
          "info": "Shown in quotes under the description."
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "info": "Defaults to “View [Collection title]” when empty."
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button link",
          "info": "Defaults to the collection URL, then the product URL."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collection",
      "blocks": [
        { "type": "featured_slide" },
        { "type": "featured_slide" },
        { "type": "featured_slide" },
        { "type": "featured_slide" },
        { "type": "featured_slide" },
        { "type": "featured_slide" }
      ]
    }
  ]
}
{% endschema %}
