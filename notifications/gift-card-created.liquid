{%- comment -%}
  Shopify Admin → Settings → Notifications → Gift card created
  Paste this entire file into the notification editor.

  Images (upload to Settings → Files OR keep in theme Assets):
    gift_card_100.png
    gift_card_200.png
    gift_card_300.png
    gift_card_500.png

  Prefer Settings → Files + file_img_url so email clients can load the image.
  Theme asset_url is a fallback for local preview only.
{%- endcomment -%}

{% if gift_card.recipient %}
  {% if gift_card.customer %}
    {% if gift_card.customer.name != blank %}
      {% assign sender_name = gift_card.customer.name %}
    {% elsif gift_card.customer.email != blank %}
      {% assign sender_name = gift_card.customer.email %}
    {% else %}
      {% assign sender_name = gift_card.customer.phone %}
    {% endif %}
  {% else %}
    {% assign sender_name = shop.name %}
  {% endif %}

  {% if gift_card.recipient.nickname != blank %}
    {% assign recipient_name = gift_card.recipient.nickname %}
  {% elsif gift_card.recipient.name != blank %}
    {% assign recipient_name = gift_card.recipient.name %}
  {% else %}
    {% assign recipient_name = gift_card.recipient.email %}
  {% endif %}

  {% capture email_title %}
    Hi {{ recipient_name }}, you have received a gift card from {{ sender_name }}.
  {% endcapture %}
{% else %}
  {% capture email_title %}
    Here’s your {{ shop.name }} gift card.
  {% endcapture %}
{% endif %}

{%- comment -%}
  Derive whole-dollar amount from initial value, e.g. 100 / 200 / 300 / 500.
  money_without_currency → "100.00" (locale may use commas).
{%- endcomment -%}
{% assign card_value_raw = gift_card.initial_value | money_without_currency | strip %}
{% assign card_value_raw = card_value_raw | replace: ',', '' | replace: ' ', '' %}
{% assign card_value = card_value_raw | split: '.' | first %}
{% if card_value == blank %}
  {% assign card_value = '100' %}
{% endif %}

{% assign gift_card_image_filename = 'gift_card_' | append: card_value | append: '.png' %}

{%- comment -%}
  Dynamic image: gift_card_100.png, gift_card_200.png, gift_card_300.png, gift_card_500.png
  Upload those exact filenames to Shopify Admin → Settings → Files.
  file_img_url is required for emails (theme asset_url often breaks in inboxes).
{%- endcomment -%}
{% assign gift_card_image_src = gift_card_image_filename | file_img_url: '480x' %}

<!DOCTYPE html>
<html lang="en">
  <head>
  <title>{{ email_title | strip }}</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width">
  <link rel="stylesheet" type="text/css" href="/assets/notifications/styles.css">
  <style>
    .button__cell { background: {{ shop.email_accent_color }}; }
    .actions-buttons .button__cell--primary { background-color: {{ shop.email_accent_color }}; }
    a, a:hover, a:active, a:visited { color: {{ shop.email_accent_color }}; }
  </style>
</head>

  <body>
    <table align="center" class="body giftcard__body">
      <tr>
        <td class="empty-line">&nbsp;</td>
      </tr>
      <tr>
        <td class="empty-line">&nbsp;</td>
      </tr>
      <tr>
        <td>
          <table class="row content">
  <tr>
    <td class="content__cell">
      <center>
        <table class="container">
          <tr>
            <td>

{% if shop.email_logo_url %}
  <table align="center" class="giftcard__doubletopmargin">
    <tr>
      <td>
        <img src="{{ shop.email_logo_url }}" alt="{{ shop.name }}" class="giftcard__logosize" width="{{ shop.email_logo_width }}">
      </td>
    </tr>
  </table>
{% endif %}

{% if gift_card.recipient %}
  <table align="center" class="row giftcard__topmargin">
    <tr>
      <td class="giftcard__title">{{ email_title | strip }}</td>
    </tr>
  </table>
{% endif %}

{% if gift_card.recipient and gift_card.message != blank %}
  <table align="center" class="row giftcard__topmargin">
    <tr>
      <td class="giftcard__message">
        "{{ gift_card.message }}"
      </td>
    </tr>
  </table>
{% endif %}

<table align="center" class="giftcard__topmargin">
  <tr>
    <td class="giftcard__balance">{{ gift_card.initial_value | money_with_currency }}</td>
  </tr>
  {% if gift_card.expires_on %}
    <tr>
      <td class="giftcard__smalltext">
        Expires {{ gift_card.expires_on | date: '%B %e, %Y' }}
      </td>
    </tr>
  {% endif %}
</table>

<table align="center" class="giftcard__doubletopmargin">
  <tr>
    <td>
      <img
        src="{{ gift_card_image_src }}"
        alt="{{ shop.name }} ${{ card_value }} gift card"
        width="240"
        height="160"
        style="display:block;margin:0 auto;border:0;outline:none;text-decoration:none;"
      >
    </td>
  </tr>
</table>

<table align="center" class="row giftcard__topmargin">
  <tr>
    <td class="giftcard__shop_name">{{ shop.name }}</td>
  </tr>
</table>

<table align="center" class="row giftcard__topmargin">
  <tr>
    <td class="giftcard__smalltext">
      Use the gift card code online
    </td>
  </tr>
  <tr>
    <td class="giftcard__code">
      {{ gift_card.code | format_code }}
    </td>
  </tr>
</table>

<table class="row actions">
  <tr>
    <td class="actions__cell">
      <table align="center" class="button">
        <tr>
          <td class="button__cell"><a href="{{ shop.url }}" class="button__text">Visit online store</a></td>
        </tr>
      </table>
      <table align="center" class="button">
        <tr>
          <td class="link__cell"><a href="{{ gift_card.url }}" class="link__text">View gift card balance</a></td>
        </tr>
      </table>
    </td>
  </tr>
</table>

{% if gift_card.pass_url %}
  <table align="center" class="row">
    <tr>
      <td class="giftcard__textcenter">
        <a href="{{ gift_card.pass_url }}" class="apple-wallet-button">
          <img src="{{ 'gift-card/add-to-apple-wallet.png' | shopify_asset_url }}" alt="Add to Apple Wallet" width="120" height="40">
        </a>
      </td>
    </tr>
  </table>
{% endif %}

            </td>
          </tr>
        </table>
      </center>
    </td>
  </tr>
</table>
          <table class="row footer">
  <tr>
    <td class="footer__cell">
      <center>
        <table class="container">
          <tr>
            <td>
              <p class="disclaimer__subtext">If you have any questions, reply to this email or contact us at <a href="mailto:{{ shop.email }}">{{ shop.email }}</a>.<!-- shopify-shop-marketplace-footer --></p>
            </td>
          </tr>
        </table>
      </center>
    </td>
  </tr>
</table>

<img src="{{ 'notifications/spacer.png' | shopify_asset_url }}" class="spacer" height="1" />

        </td>
      </tr>
    </table>
  </body>
</html>
