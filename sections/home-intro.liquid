<section
  class="home-story home-intro origin-center relative z-10 flex w-full flex-col items-center justify-center px-6 text-center text-white"
  data-header-context="dark"
  aria-labelledby="home-intro-heading-{{ section.id }}"
  {{ section.shopify_attributes }}
>


  {%- if section.settings.heading != blank -%}
    <h1
      id="home-intro-heading-{{ section.id }}"
      class="home-story__headline home-intro__headline mb-8 text-2xl uppercase text-white md:mb-10 md:text-3xl lg:text-4xl"
    >
      {{ section.settings.heading | escape }}
    </h1>
  {%- else -%}
    <h1 class="sr-only">Forever Art | OWN YOUR STORY</h1>
  {%- endif -%}

  {%- if section.settings.quote != blank -%}
    <blockquote class="home-story__quote home-intro__quote mx-auto mb-10 max-w-xl md:mb-12">
      <p class="leading-relaxed text-white">{{ section.settings.quote | escape }}</p>
    </blockquote>
  {%- endif -%}

  {%- if section.settings.attribution_name != blank or section.settings.attribution_role != blank -%}
    <footer class="home-story__attribution home-intro__attribution flex flex-col items-center gap-1">
      {%- if section.settings.attribution_name != blank -%}
        <p class="home-story__name text-sm text-white md:text-base">{{ section.settings.attribution_name | escape }}</p>
      {%- endif -%}
      {%- if section.settings.attribution_role != blank -%}
        <p class="home-story__role text-[0.65rem] uppercase tracking-[0.18em] text-white/75 md:text-xs">
          {{ section.settings.attribution_role | escape }}
        </p>
      {%- endif -%}
    </footer>
  {%- endif -%}

  {%- if section.settings.show_scroll_indicator -%}
    <button
      type="button"
      class="mt-8 flex cursor-pointer justify-center border-0 bg-transparent p-0 text-inherit md:mt-10"
      data-scroll-indicator
      aria-label="Scroll to next section"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 object-contain" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
      </svg>
    </button>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Home intro",
  "tag": "section",
  "class": "home-intro-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Monogram image",
      "info": "Optional monogram image for this section."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Monogram alt text",
      "default": "Quill monogram"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "OWN YOUR STORY"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "We don't create products, we create pieces that refuse to be forgotten"
    },
    {
      "type": "text",
      "id": "attribution_name",
      "label": "Attribution name",
      "default": "Andrew Scott"
    },
    {
      "type": "text",
      "id": "attribution_role",
      "label": "Attribution role",
      "default": "Founder | Artisan | Maker"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show scroll indicator",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Home intro"
    }
  ]
}
{% endschema %}
