<section
    class="home-story-2 origin-center relative z-10 flex w-full flex-col items-center justify-center bg-white px-6 !pb-24 text-center text-white"
    data-header-context="dark"
    aria-labelledby="home-story-heading"
  >
  
    <h2
      id="home-story-heading"
      class="home-story__headline mb-8 text-2xl uppercase text-black md:mb-10 md:text-3xl lg:text-4xl"
    >
      Our Rebellion
    </h2>
    <blockquote class="home-story__quote mx-auto mb-10 max-w-xl md:mb-12">
      <p class="leading-relaxed text-black">
        “As the noise increases, we choose authenticity over approval. Always”
      </p>
    </blockquote>
    <footer class="home-story__attribution flex flex-col items-center gap-1">
      <p class="home-story__name text-sm text-black md:text-base">Andrew Scott</p>
      <p class="home-story__role text-[0.65rem] uppercase tracking-[0.18em] text-black/75 md:text-xs">
        Founder | Artisan | Maker
      </p>
    </footer>
    <div class="mt-8 text-black flex justify-center md:mt-10" aria-hidden="true">
        <img src="/assets/arrow-down.svg" alt="Arrow down" class="h-6 w-6 object-contain" width="24" height="24" decoding="async" />
    </div>
  </section>

  <section class="home-collections relative z-10 bg-black px-4 py-16 text-center md:px-6 md:py-20 lg:py-24" data-header-context="light" aria-labelledby="home-collections-heading">
    <div class="mx-auto max-w-4xl">
      <h2 id="home-collections-heading" class="home-collections__title mb-10 text-4xl md:mb-12 md:text-5xl lg:text-6xl">
        Corporate
      </h2>
  
      <div
        class="home-collections__filters mb-10 flex flex-wrap items-center justify-center gap-3 md:mb-12 md:gap-4"
        role="tablist"
        aria-label="Collection categories"
      >
        <button
          type="button"
          class="home-collections__pill home-corporate__pill home-collections__pill home-corporate__pill--active"
          role="tab"
          aria-selected="true"
          aria-controls="home-collections-panel"
          id="home-collections-tab-wedding"
        >
         Real Estate
        </button>
        <button
          type="button"
          class="home-collections__pill home-corporate__pill"
          role="tab"
          aria-selected="false"
          tabindex="-1"
        >
         Commercial Spaces
        </button>
        <button
          type="button"
          class="home-collections__pill home-corporate__pill"
          role="tab"
          aria-selected="false"
          tabindex="-1"
        >
       Home Office
        </button>
        <button type="button" class="home-collections__pill home-corporate__pill" role="tab" aria-selected="false" tabindex="-1">
          More…
        </button>
      </div>
  
      <div
        id="home-collections-panel"
        role="tabpanel"
        aria-labelledby="home-collections-tab-wedding"
        class="home-collections__description home-corporate__description mx-auto max-w-2xl !text-white text-pretty"
      >
        <p>
          Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's
          standard dummy text ever since…
        </p>
      </div>
    </div>
    <section class="my-10 mx-auto max-w-screen">
