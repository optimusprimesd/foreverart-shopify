{{ 'product-form-config-builder.min.css' | asset_url | stylesheet_tag }}

<div class="pfcb" id="product-form-config-builder">
  <header class="pfcb__header">
    <h1 class="text-2xl font-semibold">{{ section.settings.heading | default: page.title | escape }}</h1>
    {%- if section.settings.intro != blank -%}
      <p class="pfcb__subtitle">{{ section.settings.intro }}</p>
    {%- else -%}
      <p class="pfcb__subtitle">
        Build wizard steps and fields, then copy the JSON into a product&rsquo;s
        <strong>Product Form Configuration</strong> metafield (<code>custom.product_form_configuration</code>).
      </p>
    {%- endif -%}
  </header>

  <div class="pfcb__toolbar">
    <button type="button" class="pfcb__btn" data-action="load-sample">Load sample</button>
    <button type="button" class="pfcb__btn" data-action="add-step">Add step</button>
    <button type="button" class="pfcb__btn pfcb__btn--primary" data-action="copy-json">Copy JSON</button>
  </div>

  <div class="pfcb__layout">
    <section class="pfcb__panel" aria-label="Form builder" data-pfcb-builder-panel>
      <div class="pfcb__panel-head">
        <h2 class="text-base font-semibold">Steps &amp; fields</h2>
      </div>
      <div class="pfcb__panel-body" data-pfcb-steps></div>
    </section>

    <section class="pfcb__panel" aria-label="Generated JSON" data-pfcb-json-panel>
      <div class="pfcb__panel-head">
        <div class="pfcb__panel-head-title">
          <h2 class="text-base font-semibold">Generated JSON</h2>
          <span class="pfcb__json-status" data-pfcb-json-status hidden aria-live="polite">Updated</span>
        </div>
        <button type="button" class="pfcb__btn pfcb__btn--primary" data-action="copy-json">Copy</button>
      </div>
      <div class="pfcb__panel-body">
        <textarea class="pfcb__json" data-pfcb-json readonly aria-label="Generated product form configuration JSON"></textarea>

        <div class="pfcb__import">
          <p class="text-sm font-semibold mb-2">Import existing JSON</p>
          <textarea data-pfcb-import placeholder='{ "heading": "Customize Your Sign", "steps": [ ... ] }'></textarea>
          <div class="pfcb__toolbar" style="margin-top:0.5rem;margin-bottom:0">
            <button type="button" class="pfcb__btn" data-action="import-json">Import JSON</button>
          </div>
        </div>

        <p class="pfcb__help">
          Paste the copied JSON in Shopify admin → Product → Metafields →
          <strong>Product Form Configuration</strong>.
          See <code>docs/product-form-config.md</code> in the theme repo for field type reference.
        </p>
      </div>
    </section>
  </div>
</div>

<script type="application/json" id="product-form-config-sample">
{% render 'product-form-config-sample' %}
</script>
<script src="{{ 'product-form-config-builder.min.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Form config builder",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product form config builder"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Build wizard steps and fields, then copy the JSON into each product's Product Form Configuration metafield."
    }
  ],
  "presets": [
    {
      "name": "Form config builder"
    }
  ]
}
{% endschema %}
