{%- comment -%} Mobile & iPad portrait header bar (< 1024px) {%- endcomment -%}
<div class="site-header__template site-header__template--mobile" data-site-header-template="mobile">
  <nav class="site-header__nav h-full border-0 bg-transparent" aria-label="Mobile header">
    <div class="site-header__inner site-header__inner--mobile mx-auto flex h-full max-w-screen-xl items-center justify-between gap-3 px-4">
      {% render 'header-logo' %}

      <div class="site-header__actions site-header__actions--mobile flex shrink-0 items-center gap-1 sm:gap-2">
        <div class="site-header__utilities flex items-center gap-1 sm:gap-2">
          <a href="{{ routes.cart_url }}" class="site-header__utility-link flex h-10 w-10 items-center justify-center rounded-lg focus:outline-none focus:ring-2 focus:ring-default" aria-label="Cart">
            <img src="{{ 'cart.svg' | asset_url }}" alt="" class="h-6 w-6 object-contain" width="24" height="24" decoding="async" />
          </a>
        </div>

        <button
          type="button"
          class="site-header__menu-toggle"
          data-site-header-menu-toggle
          aria-expanded="false"
          aria-controls="site-header-drawer-panel"
          aria-label="Open menu"
        >
          <span class="site-header__menu-toggle-box" aria-hidden="true">
            <span class="site-header__menu-toggle-line"></span>
            <span class="site-header__menu-toggle-line"></span>
            <span class="site-header__menu-toggle-line"></span>
          </span>
        </button>
      </div>
    </div>
  </nav>
</div>
