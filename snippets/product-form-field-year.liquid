{%- assign field = field | default: nil -%}
{%- assign product = product | default: nil -%}
{%- if field != nil -%}

{%- assign field_key = field.key | default: 'year' -%}
{%- assign property_name = field.property_name | default: field_key -%}
{%- assign placeholder = field.placeholder | default: 'Select year' -%}
{%- assign year_min = field.year_min | default: 1900 -%}
{%- assign year_max = field.year_max | default: '' -%}
{%- if year_max == blank -%}
  {%- assign year_max = 'now' | date: '%Y' | plus: 0 -%}
{%- endif -%}

{%- assign show_help = field.show_help | default: false -%}
{%- assign show_voice = field.show_voice | default: false -%}
{%- assign show_video = field.show_video | default: false -%}
{%- if show_help == true or show_help == 'true' -%}
  {%- assign show_help_enabled = true -%}
{%- else -%}
  {%- assign show_help_enabled = false -%}
{%- endif -%}
{%- if show_voice == true or show_voice == 'true' -%}
  {%- assign show_voice_enabled = true -%}
{%- else -%}
  {%- assign show_voice_enabled = false -%}
{%- endif -%}
{%- assign help_title = field.help_title | default: placeholder -%}
{%- assign help_body = field.help_body | default: '' -%}
{%- assign tooltip_id = 'help-tooltip-' | append: field_key -%}
{%- assign voice_audio_id = 'voice-audio-' | append: field_key -%}
{%- assign has_actions = false -%}
{%- if show_help_enabled or show_voice_enabled or show_video == true or show_video == 'true' -%}
  {%- assign has_actions = true -%}
{%- endif -%}

{%- assign field_charge_cents = 0 -%}
{%- if field.additional_charge != blank -%}
  {%- assign field_charge_cents = field.additional_charge | times: 100 | round -%}
{%- endif -%}

<div class="wizard__select-field w-full {{ field.wrap_class }}">
  <div class="wizard__select-field-box">
    <div class="wizard__select-field-header flex w-full flex-wrap items-center justify-between gap-2">
      <label for="{{ field_key }}" class="product-page__label mb-0 min-w-0 flex-1 text-base font-bold text-[#141414]">{{ placeholder }}</label>
      {%- if has_actions -%}
        {% render 'product-field-header-actions',
          product: product,
          field_key: field_key,
          tooltip_id: tooltip_id,
          tooltip_aria_label: help_title,
          show_help: show_help_enabled,
          tooltip_title: help_title,
          tooltip_body: help_body,
          show_voice: show_voice_enabled,
          show_video: show_video,
          voice_src: field.voice_src,
          media_url: field.media_url
        %}
      {%- endif -%}
    </div>
    <div class="wizard__input-info-wrap wizard__input-info-wrap--select-only">
      <select
        name="properties[{{ property_name }}]"
        id="{{ field_key }}"
        class="product-page__input product-page__input--select w-full"
        aria-label="{{ placeholder }}"
        {% if field.required %}aria-required="true"{% endif %}
        {% if field_charge_cents > 0 %}data-additional-charge-cents="{{ field_charge_cents }}"{% endif %}
      >
        <option value="" disabled selected>Select year</option>
        {%- for year in (year_min..year_max) reversed -%}
          <option value="{{ year }}">{{ year }}</option>
        {%- endfor -%}
      </select>
    </div>
  </div>
  {% render 'product-form-field-info', info_label: field.info_label, additional_charge: field.additional_charge %}
</div>
{%- endif -%}
