@font-face {
  font-family: "Zolina";
  src: url("{{ 'Zolina-Thin.woff2' | asset_url }}") format("woff2"),
       url("{{ 'Zolina-Thin.woff' | asset_url }}") format("woff");
  font-weight: 100;
  font-style: normal;
  font-display: swap;
}

